# BETTERAuth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=""

# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
DATABASE_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=

# Cloudflare R2 Settings
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Guest comment images: private staging, then direct delivery from a separate public bucket.
# The staging bucket must keep r2.dev and custom domains disabled.
R2_COMMENT_BUCKET_NAME=
R2_COMMENT_PUBLIC_BUCKET_NAME=
R2_COMMENT_PUBLIC_URL=
# Object credentials scoped to BOTH dedicated comment buckets only.
R2_COMMENT_ACCESS_KEY_ID=
R2_COMMENT_SECRET_ACCESS_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional separate HMAC secret; falls back to BETTER_AUTH_SECRET.
COMMENT_ABUSE_SECRET=
# Set false to pause guest activity while preserving member comments.
GUEST_COMMENTS_ENABLED=true
GUEST_COMMENT_UPLOADS_ENABLED=true

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CRON_SECRET=

# SUPABASE
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=
